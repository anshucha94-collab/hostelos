generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id      Int    @id @default(autoincrement())
  name    String
  branch  String
  room    String
  status  String
}
model EntryLog {
  id        Int      @id @default(autoincrement())
  student   String
  action    String
  createdAt DateTime @default(now())
}